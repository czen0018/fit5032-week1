{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fit5032-week1",
  "compatibility_date": "2026-10-19",
  // Static Vue build served by Cloudflare Workers static assets.
  // single-page-application: unknown paths like /WeatherCheck fall back to index.html
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
